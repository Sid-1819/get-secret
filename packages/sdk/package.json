{
  "name": "@getsecret/sdk",
  "version": "2.0.0",
  "description": "TypeScript client for the getsecret secure secrets HTTP API",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sid-1819/getsecret.git"
  },
  "homepage": "https://github.com/Sid-1819/getsecret#readme",
  "bugs": {
    "url": "https://github.com/Sid-1819/getsecret/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
