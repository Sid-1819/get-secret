{
  "name": "@getsecret/cli",
  "version": "1.0.0",
  "description": "Terminal CLI for the getsecret secure secrets HTTP API",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sid-1819/getsecret.git"
  },
  "homepage": "https://github.com/Sid-1819/getsecret#readme",
  "bugs": {
    "url": "https://github.com/Sid-1819/getsecret/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "getsecret": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "cli": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@getsecret/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
