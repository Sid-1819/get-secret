{
  "name": "getsecret",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "lefthook install",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:api": "pnpm --filter @getsecret/api start:dev",
    "dev:web": "pnpm --filter @getsecret/web dev",
    "dev:playground": "pnpm --filter @getsecret/web dev",
    "dev:extension": "pnpm --filter @getsecret/extension dev",
    "cli": "pnpm --filter @getsecret/cli run cli",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm --filter @getsecret/sdk run build && pnpm --filter @getsecret/cli run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@nestjs/testing": "^11.2.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "lefthook": "^2.1.10",
    "ts-jest": "^29.4.12"
  },
  "dependencies": {
    "supertest": "^7.2.2"
  }
}
