DATABASE_URL=""
# Optional. Leave empty for Postgres-only dev (no rate limits or cache).
# Any Redis-protocol server works: Redis, Valkey, Dragonfly, KeyDB, ElastiCache, Upstash (redis:// or rediss://).
REDIS_URL=""
# Required. 32-byte key: hex (64 chars) or base64 (44 chars). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Browser CORS: `*` (default) allows any origin so third parties can use @getsecret/sdk in the browser.
# Or comma-separated list, e.g. http://localhost:8080,http://localhost:5174
CORS_ORIGIN=*
